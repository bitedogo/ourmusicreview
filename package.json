{
  "name": "music_review",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:build": "npm run check && npm run build",
    "postinstall": "patch-package",
    "icons:oru": "node scripts/generate-oru-app-icons.mjs",
    "db:migrate": "node scripts/run-migration.mjs --all",
    "db:migrate:profile-privacy": "node scripts/run-migration.mjs add-profile-privacy-columns.sql",
    "db:migrate:playlists": "node scripts/run-migration.mjs add-playlist-tables.sql",
    "db:migrate:playlists-privacy": "node scripts/run-migration.mjs add-playlists-privacy-column.sql",
    "db:migrate:email-auth": "node scripts/run-migration.mjs add-email-auth-columns.sql",
    "db:migrate:email-otp": "node scripts/run-migration.mjs add-email-otp-challenges.sql",
    "db:migrate:genres": "node scripts/run-migration.mjs add-genre-tables.sql",
    "db:migrate:comments": "node scripts/run-migration.mjs add-comment-replies-and-likes.sql",
    "db:migrate:review-views": "node scripts/run-migration.mjs add-review-views.sql",
    "db:migrate:review-rating-precision": "node scripts/run-migration.mjs add-review-rating-precision.sql",
    "db:migrate:playlist-likes-comments": "node scripts/run-migration.mjs add-playlist-likes-comments.sql",
    "db:migrate:user-sanctions": "node scripts/run-migration.mjs add-user-sanctions.sql",
    "db:migrate:blocked-emails": "node scripts/run-migration.mjs add-blocked-emails.sql",
    "db:migrate:notifications": "node scripts/run-migration.mjs add-notifications.sql",
    "db:migrate:announcement-cursors": "node scripts/run-migration.mjs add-announcement-cursors.sql",
    "db:migrate:inquiries": "node scripts/run-migration.mjs add-inquiries.sql",
    "db:migrate:data-integrity": "node scripts/run-migration.mjs add-data-integrity-constraints.sql",
    "db:migrate:auth-security": "node scripts/run-migration.mjs add-auth-security.sql",
    "db:seed:genres": "node scripts/seed-genres.mjs",
    "media:rewrite-r2-urls": "node scripts/rewrite-storage-urls-to-r2.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@headlessui/react": "^2.2.10",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.95.3",
    "@toast-ui/editor": "^3.2.2",
    "@toast-ui/react-editor": "^3.2.3",
    "bcryptjs": "^3.0.3",
    "dompurify": "^3.4.15",
    "marked": "^18.0.9",
    "next": "^16.3.4",
    "next-auth": "^4.24.15",
    "patch-package": "^8.0.1",
    "pg": "^8.13.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-image-crop": "^11.0.10",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "typeorm": "^0.3.31",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.28",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@toast-ui/editor": {
      "dompurify": "$dompurify"
    }
  }
}
