# ===========================================
# Music Review - 환경 변수 템플릿
# 이 파일을 .env.local 로 복사한 뒤 실제 값으로 채워주세요.
# ===========================================

# Supabase PostgreSQL 연결
# Supabase Dashboard > Project Settings > Database 에서 연결 문자열 확인
DATABASE_URL=postgresql://postgres.zdggogbgkvgjkjngvxwn:[YOUR_PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# NextAuth
# NEXTAUTH_SECRET 생성: openssl rand -base64 32
NEXTAUTH_SECRET=your-generated-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Supabase Storage (프로필 이미지)
# Supabase Dashboard > Settings > API 에서 확인
SUPABASE_URL=https://zdggogbgkvgjkjngvxwn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
